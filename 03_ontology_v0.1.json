{
  "ontology_version": "0.1",
  "scope_note": "Provisional model of how 宁波润悦服饰有限公司 understands and operationalises an apparel order. Grounded in one complete case (FBB54S2-997XLB / 1152246 / M7797 / Lane Bryant), the 2026 order register, and the portfolio quote. NOT a model of the apparel industry.",
  "authoritative_clarifications": {
    "C1": "F1 客户 = 外贸公司 + 理单员 (乙方 tier). Never the brand.",
    "C2": "商店 / STORE = 品牌 (甲方).",
    "C3": "名苑 is canonical spelling; 茗苑 normalises to 名苑.",
    "C4": "For FBB54S2-997XLB, 交期=2026-04-20 is the customer commitment; 4/25 (D7) and 5/7 (D8) are internal stage deadlines.",
    "C5": "画稿 codes (997X etc.) are linking IDs to .ai art masters.",
    "C6": "F1 col 13 = 单价 (booked unit price); col 14 = 金额 (line amount).",
    "C7": "BCI in D2 客户 is BCI Brands — a real vendor/importer in the LB → BCI → 锦秀 → 润悦 → 名苑 chain. Not a data error."
  },
  "modelling_decisions_applied": {
    "M1": "No universal OrderLine — split PricingLine / PurchaseOrder / SizeAllocation / CartonAllocation by grain.",
    "M2": "Three prices: target / quoted / booked, each with source and timestamp.",
    "M3": "Delivery dates: contract_delivery_date / expected_delivery_date / actual_ship_date + StageDeadline objects for internal targets.",
    "M4": "PurchaseOrder is first-class, not a Shipment attribute.",
    "M5": "Colour has 4 coexisting names (buyer/factory/swatch/raw); no forced universal key.",
    "M6": "Program is a first-class entity.",
    "M7": "U-1/U-2/U-3/U-4 preserved as UNRESOLVED, not guessed."
  },
  "layers": [
    "L1_party",
    "L2_commercial",
    "L3_product_specification",
